# ================================================================
# NARAGA — Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# ================================================================

# Database PostgreSQL (Supabase)
# Gunakan "Transaction" connection string (port 6543) untuk DATABASE_URL
# Gunakan "Session" connection string (port 5432) untuk DIRECT_URL
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# NextAuth / Auth.js
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini API
# Gunakan "mock" untuk respons offline, atau isi kunci AIzaSy... dari Google AI Studio
GEMINI_API_KEY="mock"
